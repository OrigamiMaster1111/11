#include "stm32f10x.h"

int16_t Encoder_count = 0;

void Encoder_Init(void){
    RCC_APB1PeriphClockCmd(RCC_APB1Periph_TIM3, ENABLE);
    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA, ENABLE);

    GPIO_InitTypeDef GPIO_InitStructure = {
        .GPIO_Mode = GPIO_Mode_IPU,
        .GPIO_Pin = GPIO_Pin_6 | GPIO_Pin_7,
        .GPIO_Speed = GPIO_Speed_50MHz,
    };
    GPIO_Init(GPIOA, &GPIO_InitStructure);


    TIM_TimeBaseInitTypeDef TIM_TimeBaseInitStructure = {
        .TIM_ClockDivision = TIM_CounterMode_Up,
        .TIM_CounterMode = 65536 - 1, // ARR
        .TIM_Period = 72 - 1,         // PSC
        .TIM_Prescaler = 1 - 1,
        .TIM_RepetitionCounter = 0,
    };
    TIM_TimeBaseInit(TIM3, &TIM_TimeBaseInitStructure);


    TIM_ICInitTypeDef TIM_ICInitStructure = {
        .TIM_Channel = TIM_Channel_1,
        .TIM_ICFilter = 0xF,
        // .TIM_ICPolarity = TIM_ICPolarity_Rising   此处的配置会被最后的配置覆盖，可注释
        .TIM_ICPrescaler = TIM_ICPSC_DIV1,
        .TIM_ICSelection = TIM_ICSelection_DirectTI,
    };
    TIM_ICInit(TIM3, &TIM_ICInitStructure);
    TIM_ICStructInit(&TIM_ICInitStructure);
    TIM_ICInitStructure.TIM_Channel = TIM_Channel_2;
    TIM_ICInitStructure.TIM_ICFilter = 0xF;
    // TIM_ICInitStructure.TIM_ICPolarity = TIM_ICPolarity_Rising; 此处的配置会被最后的配置覆盖，可注释
    TIM_ICInit(TIM3, &TIM_ICInitStructure);


    TIM_EncoderInterfaceConfig(TIM3, TIM_EncoderMode_TI12/*TI1、TI2都计数*/, TIM_ICPolarity_Rising, TIM_ICPolarity_Rising); //都不反相

    TIM_Cmd(TIM3, ENABLE);
}


uint16_t Encoder_Get(void){
    // 注意 TIM_GetCapture 是输入捕获模式下拿到捕获寄存器的值，而TIM_GetCounter是拿到计数器的值
    int16_t Temp;
    Temp = TIM_GetCounter(TIM3);
    TIM_SetCounter(TIM3, 0);
    return Temp;
}




#include "stm32f10x.h"
#include "Delay.h"
#include "OLED_I2C.h"
#include "Encoder.h"
#include "Timer.h"

int16_t Speed = 0;

int main(){

    OLED_Init();
    // Timer_Init();
    Encoder_Init();
    
    
    OLED_ShowString(1, 3, "CNT:");
    
    while (1){
        OLED_ShowNum(1, 7, Speed, 5);
    }
}

void TIM2_IRQHandler(void){
    if (TIM_GetITStatus(TIM2, TIM_IT_Update) == SET){
        Speed++;
        TIM_ClearITPendingBit(TIM2, TIM_IT_Update);
    }
}

