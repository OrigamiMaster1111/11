main.c

#include "stm32f10x.h"
#include "Delay.h"
#include "OLED_I2C.h"
#include "Encoder.h"
#include "Timer.h"

int16_t Num = 0;

int main(){

    OLED_Init();
    Timer_Init();
    
    
    OLED_ShowString(1, 3, "HelloWorld");
    
    while (1){
        OLED_ShowNum(1, 5, Num, 5);
        OLED_ShowNum(1, 5, TIM_GetCounter(TIM2), 5);
    }
}

void TIM2_IRQHandler(void){
    if (TIM_GetITStatus(TIM2, TIM_IT_Update) == SET){
        Num++;
        TIM_ClearITPendingBit(TIM2, TIM_IT_Update);
    }
}



