#include "stm32f10x.h"
#include "Delay.h"

int main(){

	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA, ENABLE);
	GPIO_InitTypeDef GPIO_InitStructure = {
		.GPIO_Mode = GPIO_Mode_Out_PP,  // 推挽输出
		.GPIO_Pin = GPIO_Pin_All,		    // pin0引脚
		.GPIO_Speed = GPIO_Speed_50MHz,
	};
	GPIO_Init(GPIOA, &GPIO_InitStructure);

	// 输入输出函数
	GPIO_ResetBits(GPIOA, GPIO_Pin_0); //输出低电平
	GPIO_SetBits(GPIOA, GPIO_Pin_0);   //输出高电平
	GPIO_WriteBit(GPIOA, GPIO_Pin_0, Bit_RESET);   //Bit_RESET低电平 Bit_SET高电平
	
	while(1){
		GPIO_Write(GPIOA, ~0x0001); // 实际写入 0xFFFE (1111 1111 1111 1110) PA0亮（低电平亮）
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0002); // 0000 0000 0000 0010
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0004); // 0000 0000 0000 0100
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0008); // 0000 0000 0000 1000
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0010); // 0000 0000 0001 0000
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0020); // 0000 0000 0010 0000
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0040); // 0000 0000 0100 0000
		Delay_ms(500);
		GPIO_Write(GPIOA, ~0x0080); // 0000 0000 1000 0000
		Delay_ms(500);
	}
}
